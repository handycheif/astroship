        <p class="description">
            Learn the exact strategies, confidence tricks, and frameworks needed to stand out and land your dream job offer.
        </p>
    </div>
    <a class="buy-button payhip-buy-button" data-product="1NyBj" href="https://payhip.com" target="_blank">
        Buy Ebook Now
    </a>
</div>

<!-- PRODUCT 3 -->
<div class="card">
    <div>
        <div class="image-container">
            <img src="https://your-cloudflare-domain.com" alt="Amazon Income Guide" class="product-image">
        </div>
