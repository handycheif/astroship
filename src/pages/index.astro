<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DOWNLOADOLOGY - Digital Store</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0f172a;
    color: #fff;
    min-height: 100vh;
    padding: 40px 20px;
}

.header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px auto;
}

h1 {
    color: #34d399;
    font-size: 2.8rem;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.subtitle {
    color: #94a3b8;
    font-size: 1.2rem;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    max-width: 1100px;
    margin: 0 auto;
}

.card {
    background: #1e293b;
    border-radius: 15px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #334155;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #10b981;
}

h2 {
    font-size: 1.5rem;
    color: #f8fafc;
    margin-bottom: 15px;
    line-height: 1.4;
}

.price {
    color: #22c55e;
    font-size: 1.8rem;
    font-weight: bold;
    margin-bottom: 15px;
}

.description {
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 0.95rem;
    margin-bottom: 25px;
    flex-grow: 1;
}

.buy-button {
    display: block;
    text-align: center;
    background: #10b981;
    color: #fff;
    text-decoration: none;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    transition: .3s;
}

.buy-button:hover {
    background: #059669;
}
</style>

</head>
<body>

<div class="header">
    <h1>DOWNLOADOLOGY</h1>
    <p class="subtitle">Premium digital assets delivered instantly.</p>
      <!-- PRODUCT 1 -->
    <div class="card">
        <div>
            <h2>Make Your First $100 on the Web</h2>
            <div class="price">$4.99</div>
            <p class="description">
                Learn practical strategies for launching digital products,
                building an audience, and earning your first online income.
            </p>
        </div>
        <!-- BULLETPROOF PAYHIP BUTTON -->
        <a class="buy-button payhip-buy-button" data-product="4QgJm" href="https://payhip.com/b/4QgJm" target="_blank">
            Buy Ebook Now
        </a>
        <script type="text/javascript" src="https://payhip.com" async></script>
    </div>


        </div>
        <!-- FIXED LINK BELOW -->
        <a class="buy-button" href="https://payhip.com" target="_blank" rel="noopener noreferrer">
            Buy Ebook Now
        </a>
    </div>

    <!-- PRODUCT 2 -->
    <div class="card">
        <div>
            <h2>Your Second Product Name</h2>
            <div class="price">$9.99</div>
            <p class="description">
                This is a placeholder description for your next awesome digital asset. You can change this text at any time.
            </p>
        </div>
        <a class="buy-button" href="#" target="_blank" rel="noopener noreferrer">
            Coming Soon
        </a>
    </div>

</div>

</body>
</html>
