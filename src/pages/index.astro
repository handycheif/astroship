<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DOWNLOADOLOGY - Digital Store</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0f172a;
    color: #fff;
    min-height: 100vh;
    padding: 40px 20px;
}

.header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px auto;
}

h1 {
    color: #34d399;
    font-size: 2.8rem;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.subtitle {
    color: #94a3b8;
    font-size: 1.2rem;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    max-width: 1200px; 
    margin: 0 auto;
}

.card {
    background: #1e293b;
    border-radius: 15px;
    padding: 24px; 
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #334155;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #10b981;
}

.image-container {
    width: 100px !important;
    height: 150px !important;
    min-width: 100px !important;
    max-width: 100px !important;
    min-height: 150px !important;
    max-height: 150px !important;
    background: #0f172a;
    border-radius: 8px;
    margin: 0 auto 20px auto;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #334155;
}
.image-container img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: cover; 
}

h2 {
    font-size: 1.3rem; 
    color: #f8fafc;
    margin-bottom: 10px;
    line-height: 1.4;
}

.price {
    color: #22c55e;
    font-size: 1.6rem;
    font-weight: bold;
    margin-bottom: 12px;
}

.description {
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 0.9rem;
    margin-bottom: 20px;
    flex-grow: 1;
}

.buy-button {
    display: block;
    text-align: center;
    background: #10b981;
    color: #fff;
    text-decoration: none;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    transition: .3s;
    width: 100%;
}

.buy-button:hover {
    background: #059669;
}

/* RESPONSIVE BREAKPOINTS: Changes layout for tablets and phones */
@media (max-width: 1024px) {
    .products-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)); 
    }
}
@media (max-width: 640px) {
    .products-grid {
        grid-template-columns: repeat(1, minmax(0, 1fr)); 
    }
}
</style>

<!-- Payhip Official App Embed Script -->
<script type="text/javascript" src="https://payhip.com" async></script>

</head>
<body>

<div class="header">
