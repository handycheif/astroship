    </div>
    <a href="https://payhip.com/b/4QgJm" target="_blank" style="display: inline-block; background: #0070f3; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; font-weight: bold;">
        Buy Ebook Now
    </a>
</div>
  
<!-- PRODUCT 2 -->
